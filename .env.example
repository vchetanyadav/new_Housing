# Copy to .env and adjust.  cp .env.example .env
HTTP_PORT=8080
# Number of API worker processes (each holds the data in memory, ~0.5-1 GB for a council)
WEB_CONCURRENCY=2
# Optional login for the whole site. Leave blank for no login.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Scheduler: how often to check (seconds), and how old a source may get before it is re-downloaded (days)
REFRESH_SECONDS=86400
REFRESH_MAX_AGE_DAYS=7
# Only if the frontend is hosted on a different domain from the API (comma-separated)
CORS_ORIGINS=
